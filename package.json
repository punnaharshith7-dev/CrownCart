{
  "name": "crowncart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "seed:dev": "node --disable-warning=ExperimentalWarning server/scripts/seed-dev.ts",
    "create-admin": "node --disable-warning=ExperimentalWarning server/scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@hono/node-server": "^1.19.17",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@react-three/rapier": "^2.2.0",
    "hono": "^4.13.13",
    "maath": "^0.10.8",
    "postprocessing": "^6.36.7",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "typescript": "^5.7.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
