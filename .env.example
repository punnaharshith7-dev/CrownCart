# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8787
# Public URL of the storefront (used in emails and the sitemap)
PUBLIC_URL=http://localhost:5173
# Comma-separated origins allowed to make state-changing API calls (CSRF)
APP_ORIGIN=http://localhost:5173
# DATABASE_PATH=server/data/crowncart.db
# Set to 1 only when running behind a reverse proxy you control
TRUST_PROXY=0

# Development demo accounts (npm run seed:dev). Never used in production.
SEED_PASSWORD=

# First administrator for a new deployment (npm run create-admin), then remove.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Razorpay — online payments (UPI, cards, net banking, wallets). Leave blank to disable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. With EMAIL_PROVIDER=none, emails are logged, not sent.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=CrownCart <no-reply@yourdomain.com>

# Google sign-in (not yet wired — see docs/STATUS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
