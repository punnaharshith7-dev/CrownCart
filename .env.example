# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8787
# Public URL of the storefront (used in emails and the sitemap)
PUBLIC_URL=http://localhost:5173
# Comma-separated origins allowed to make state-changing API calls (CSRF)
APP_ORIGIN=http://localhost:5173
# DATABASE_PATH=server/data/crowncart.db
# Set to 1 only when running behind a reverse proxy you control
TRUST_PROXY=0


# First administrator for a new deployment (npm run create-admin), then remove.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Razorpay — online payments (UPI, cards, net banking, wallets). Leave blank to disable. See docs/INTEGRATIONS.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. With EMAIL_PROVIDER=none, emails are logged, not sent.
# EMAIL_PROVIDER=resend uses RESEND_API_KEY; EMAIL_PROVIDER=smtp uses the SMTP_* settings
# (Gmail: SMTP_USER=crowncart.admin@gmail.com, SMTP_PASS=16-character app password, ~500 emails/day).
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=CrownCart <crowncart.admin@gmail.com>
# Inbox that receives every support request and contact message (only this address). Defaults to INITIAL_ADMIN_EMAIL.
ADMIN_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Google sign-in — see docs/INTEGRATIONS.md for the redirect URI to register
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (Entra ID, "personal + work accounts") — redirect URI: <site>/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# AI shopping assistant (customers only). Set ONE of these; leave both blank to hide the assistant.
# Gemini has a free tier: get a key at https://aistudio.google.com/apikey (used first when set).
# Note: on Gemini's free tier Google may use requests to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
# Claude (paid, pay-as-you-go): https://console.anthropic.com
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# SMS & WhatsApp via Twilio. Leave blank to log messages instead of sending.
# SMS gateway: SMS_PROVIDER=twilio (default) or textbee (free: your own Android phone + SIM, see textbee.dev)
SMS_PROVIDER=twilio
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Courier: Shiprocket API user (Settings → API → Create API user in Shiprocket)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Any long random string; set the same value as the webhook token in Shiprocket
SHIPROCKET_WEBHOOK_TOKEN=
